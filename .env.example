BOT_TOKEN=123456:replace_me
ADMIN_CHAT_ID=-1001234567890
AI_REQUEST_TIMEOUT=60
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USE_FORUM_TOPICS=true
KB_PATH=knowledge_base.json
USE_VECTOR_RAG=false
TIMEZONE=Asia/Qyzylorda
WORKDAY_START_HOUR=9
WORKDAY_START_MINUTE=30
WORKDAY_END_HOUR=18
REPORT_HOUR=18
DUTY_CONTACT=

# --- Docker-инфраструктура -------------------------------------------------

# PostgreSQL (заменяет DATABASE_PATH/support.db).
# Внутри docker-compose хост "postgres" -- имя сервиса, для локального
# запуска без Docker используйте localhost.
DATABASE_URL=postgresql://kdbl:kdbl@postgres:5432/support
POSTGRES_PASSWORD=kdbl

# ChromaDB Server (заменяет локальный CHROMA_DIR).
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Алерты Prometheus/Alertmanager -> Telegram (тема "Alerts" в операторской группе).
# ALERT_CHAT_ID по умолчанию = ADMIN_CHAT_ID, если не задан отдельно.
ALERT_CHAT_ID=-1004468256184
ALERT_THREAD_ID=

# Grafana (http://<host>:3000, логин admin/<пароль>).
GF_SECURITY_ADMIN_PASSWORD=admin

# Apache Superset (http://<host>:8088, логин admin/<пароль>).
# Metadata хранится в SQLite (volume). Postgres support подключайте в UI как datasource.
SUPERSET_SECRET_KEY=kdbl-superset-dev-secret-change-me-in-production-please-32b
SUPERSET_ADMIN_PASSWORD=admin
